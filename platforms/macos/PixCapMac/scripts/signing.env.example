# PixCap signing configuration.
#
# Copy to `signing.env` (gitignored) and fill in. When PIXCAP_SIGN_IDENTITY is
# empty the build falls back to an ad-hoc signature, which works locally but is
# blocked by Gatekeeper on other Macs.
#
# List your identities with:
#     security find-identity -v -p codesigning

# Developer ID Application certificate, copied verbatim from that command.
# Neither the certificate name nor the Team ID is secret — both appear in every
# signed binary you ship.
PIXCAP_SIGN_IDENTITY="Developer ID Application: YOUR NAME (TEAMID1234)"

# Team ID, the value in parentheses above.
PIXCAP_TEAM_ID="TEAMID1234"

# Notarisation credentials live in the Keychain, never in this file.
# Create the profile once:
#
#     xcrun notarytool store-credentials "PixCap" \
#         --apple-id "you@example.com" \
#         --team-id "TEAMID1234" \
#         --password "abcd-efgh-ijkl-mnop"
#
# The password is an app-specific password from https://account.apple.com
# (Sign-In and Security > App-Specific Passwords) — not your Apple ID password.
PIXCAP_NOTARY_PROFILE="PixCap"

# Set to 0 to sign but skip notarisation (faster; Gatekeeper still blocks
# distribution, but local installs are clean).
PIXCAP_NOTARIZE=1
