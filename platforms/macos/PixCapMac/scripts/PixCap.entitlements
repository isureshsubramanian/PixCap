<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      PixCap is not sandboxed: it captures arbitrary screen content and writes
      to a user-chosen folder, neither of which the App Sandbox permits.

      ScreenCaptureKit needs no entitlement — capture is gated by TCC at
      runtime. Uncomment the audio entitlement if microphone recording is ever
      added, otherwise the hardened runtime will block the mic.
    -->
    <!-- <key>com.apple.security.device.audio-input</key><true/> -->
    <key>com.apple.security.automation.apple-events</key>
    <false/>
</dict>
</plist>
