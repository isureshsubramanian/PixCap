# Generated by Cargo
debug
target/

# Swift PM build artifacts
.build/

# Node.js dependencies
node_modules/
**/node_modules/

# Disable/Ignore GitHub Actions Workflows (Private Repo Safety)
.github/
.github/workflows/

# Sample output renders, which the CLI and the examples write in place.
# Keep this broad, but never let it swallow real assets — anything under
# images/ or website/assets/ is committed on purpose.
*.svg
*.png
!images/**

# Full-resolution master art stays local. Commit the optimised export beside
# it instead — a 5 MB PNG in a README costs every visitor, forever.
images/masters/

# Backup files
**/*.rs.bk

# MSVC Windows builds
*.pdb

# .NET build output, and the installers build.ps1 produces
bin/
obj/
dist/

# OS files
.DS_Store
Thumbs.db

# IDE & Editor settings
.idea/
.vscode/
*.swp
*.swo

# Ignore ADRs and internal design research documents
ADR-001.md
docs/ADR-001.md
docs/
*.adr.md

# The pixcap.app marketing site is developed and deployed separately.
website/

# Environment & Credentials
.env
.env.*
*.pem
*.key
